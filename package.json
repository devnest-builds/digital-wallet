{
  "name": "digital-wallet",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:shell": "node --import @angular-architects/native-federation/node-preload dist/shell/server/server.mjs",
    "serve:ssr:wallet": "node --import @angular-architects/native-federation/node-preload dist/wallet/server/server.mjs",
    "serve:ssr:transfer": "node --import @angular-architects/native-federation/node-preload dist/transfer/server/server.mjs",
    "serve:ssr:history": "node --import @angular-architects/native-federation/node-preload dist/history/server/server.mjs"
  },
  "private": true,
  "packageManager": "npm@11.19.1",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/platform-server": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@angular/ssr": "^22.2.5",
    "express": "^5.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "es-module-shims": "^2.8.0",
    "cors": "^2.8.5"
  },
  "devDependencies": {
    "@angular-architects/native-federation": "~22.2.0",
    "@angular/build": "^22.2.5",
    "@angular/cli": "^22.2.5",
    "@angular/compiler-cli": "^22.2.0",
    "@types/express": "^5.0.1",
    "@types/node": "^22.12.0",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0",
    "@softarc/native-federation-orchestrator": "^4.8.0"
  }
}
